#!/bin/sh

HARNESS_COMMAND_NAME='harness self-test'
export HARNESS_COMMAND_NAME
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"

# Use the executing kit and its environment, never the target application's
# runner, command override or environment.
# Status selector; a non-zero result is expected and handled.
# shellcheck disable=SC2310
py=$(python_command "${KIT_ROOT}/..") ||
  fail 'Python is required to run harness contract tests'
[ -d "${KIT_ROOT}/tests" ] ||
  installation_error 'harness contract tests are missing'
note 'running harness contract tests independently of application tests'
run_project_command "${py}" "${KIT_ROOT}/bin/python-tests.py" \
  unittest "${KIT_ROOT}/tests"
