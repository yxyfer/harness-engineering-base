#!/bin/sh

HARNESS_COMMAND_NAME='harness start'
export HARNESS_COMMAND_NAME
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"

# Status selector; a non-zero result is expected and handled.
# shellcheck disable=SC2310
if override=$(command_override start); then
  source_name=$(command_override_source start)
  run_override "${source_name}" "${override}"
elif has_npm_script dev; then
  run_node_script dev
elif has_npm_script start; then
  run_node_script start
elif [ -f "${TARGET}/app.py" ]; then
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  py=$(python_command) || fail 'Python is required to run app.py'
  note 'starting app.py'
  run_project_command "${py}" app.py
elif [ -f "${TARGET}/manage.py" ]; then
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  py=$(python_command) || fail 'Python is required to run manage.py'
  note 'starting Django development server'
  run_project_command "${py}" manage.py runserver
else
  fail 'no start command detected; set HARNESS_START_COMMAND or add a package dev/start script'
fi
