#!/bin/sh

HARNESS_COMMAND_NAME='harness doctor'
export HARNESS_COMMAND_NAME
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"
harness_root=$(CDPATH='' cd "${KIT_ROOT}/.." && pwd -P)
python3 "${MANIFEST_TOOL}" verify "${harness_root}"
exec python3 "${KIT_ROOT}/bin/doctor.py" "${TARGET}" "${CONFIG_PATH}"
