#!/bin/sh

HARNESS_COMMAND_NAME='harness check'
export HARNESS_COMMAND_NAME
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"
python3 "${KIT_ROOT}/bin/profiles.py" summary "${TARGET}" "${CONFIG_PATH}"

if [ -n "${HARNESS_CHECKS_DIR:-}" ]; then
  checks_dir=${HARNESS_CHECKS_DIR}
else
  kit_root=$(find_kit_root)
  checks_dir=${kit_root:+${kit_root}/checks}
fi

if [ -n "${checks_dir}" ] && [ -d "${checks_dir}" ]; then
  note "running policy checks from ${checks_dir}"
  for check_name in $(config_list checks.required); do
    check_file="${checks_dir}/${check_name}/check"
    [ -f "${check_file}" ] && [ -x "${check_file}" ] ||
      installation_error "required policy check is missing or not executable: ${check_name}"
    if "${check_file}" "${TARGET}"; then
      :
    else
      check_status=$?
      fail "policy check '${check_name}' failed with exit ${check_status}"
    fi
  done
else
  installation_error 'policy checks not found; set HARNESS_KIT_ROOT or HARNESS_CHECKS_DIR'
fi

ran_project_check=0
# Status selector; a non-zero result is expected and handled.
# shellcheck disable=SC2310
if override=$(command_override check); then
  source_name=$(command_override_source check)
  run_override "${source_name}" "${override}"
  ran_project_check=1
elif has_npm_script check; then
  run_node_script check
  ran_project_check=1
else
  # A split native implementation must cover all three controls.
  # shellcheck disable=SC2310
  if has_npm_script lint || has_npm_script typecheck || has_npm_script format:check; then
    # shellcheck disable=SC2310
    if has_npm_script format:check && has_npm_script lint && has_npm_script typecheck; then
      run_node_script format:check
    else
      fail 'split static scripts require format:check, lint and typecheck; declare an aggregate check for equivalent tools'
    fi
  fi
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  if has_npm_script lint; then
    run_node_script lint
    ran_project_check=1
  fi
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  if has_npm_script typecheck; then
    run_node_script typecheck
    ran_project_check=1
  fi
fi

if [ "${ran_project_check}" -eq 0 ]; then
  run_project_command python3 "${KIT_ROOT}/bin/static.py" check "${TARGET}" "${CONFIG_PATH}"
fi
note 'complete'
