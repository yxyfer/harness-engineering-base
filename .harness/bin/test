#!/bin/sh

HARNESS_COMMAND_NAME='harness test'
export HARNESS_COMMAND_NAME
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"

if override=$(command_override test); then
  source_name=$(command_override_source test)
  run_override "$source_name" "$override"
elif has_npm_script test; then
  run_node_script test
elif [ -d "$TARGET/.harness/tests" ] && [ -f "$TARGET/harness" ]; then
  py=$(python_command) || fail 'Python is required to run harness contract tests'
  note 'running harness contract tests'
  run_project_command "$py" -m unittest discover -s .harness/tests -p 'test_*.py'
elif [ -d "$TARGET/tests" ]; then
  py=$(python_command) || fail 'Python is required to run the detected tests'
  if "$py" -m pytest --version >/dev/null 2>&1; then
    note 'running pytest'
    run_project_command "$py" -m pytest
  else
    note 'pytest not detected; running unittest discovery'
    run_project_command "$py" -m unittest discover -s tests
  fi
else
  fail 'no tests detected; set HARNESS_TEST_COMMAND, add a package test script, or add tests/'
fi
