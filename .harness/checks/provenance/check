#!/usr/bin/env python3
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "bin"))
from source_paths import project_file

target = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
try:
    agents_file = project_file(target, "AGENTS.md")
    data_file = project_file(target, "docs/DATA.md")
except ValueError as error:
    print(f"provenance: {error}", file=sys.stderr)
    raise SystemExit(1)
if not agents_file.is_file():
    print("provenance: skip (AGENTS.md not present)")
    raise SystemExit(0)
if not data_file.is_file():
    print("provenance: docs/DATA.md is missing", file=sys.stderr)
    raise SystemExit(1)

text = data_file.read_text(encoding="utf-8").lower()
required = ["## provenance", "source", "limitations", "synthetic", "simulated"]
missing = [term for term in required if term not in text]
if missing:
    print(
        f"provenance: DATA.md is missing: {', '.join(missing)}", file=sys.stderr
    )
    raise SystemExit(1)

print("provenance: pass")
