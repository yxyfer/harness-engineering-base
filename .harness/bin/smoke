#!/bin/sh

HARNESS_COMMAND_NAME='harness smoke'
export HARNESS_COMMAND_NAME
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"

# Status selector; a non-zero result is expected and handled.
# shellcheck disable=SC2310
if override=$(command_override smoke); then
  source_name=$(command_override_source smoke)
  run_override "${source_name}" "${override}"
elif has_npm_script smoke; then
  run_node_script smoke
elif [ -f "${TARGET}/scripts/smoke.py" ]; then
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  py=$(python_command) || fail 'Python is required to run scripts/smoke.py'
  note 'running scripts/smoke.py'
  run_project_command "${py}" scripts/smoke.py
elif [ -n "${HARNESS_BASE_URL:-}" ]; then
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  has_command curl || fail 'curl is required for URL smoke checks'
  note "requesting ${HARNESS_BASE_URL}"
  if ! curl --fail --silent --show-error --max-time 10 "${HARNESS_BASE_URL}" >/dev/null; then
    fail 'URL smoke check failed'
  fi
  note 'URL responded successfully'
else
  fail 'no smoke check detected; set HARNESS_SMOKE_COMMAND or HARNESS_BASE_URL, or add a smoke script'
fi
