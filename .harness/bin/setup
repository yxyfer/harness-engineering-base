#!/bin/sh

HARNESS_COMMAND_NAME='harness setup'
export HARNESS_COMMAND_NAME
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"

# Status selector; a non-zero result is expected and handled.
# shellcheck disable=SC2310
if override=$(command_override setup); then
  source_name=$(command_override_source setup)
  run_override "${source_name}" "${override}"
  exit 0
fi

did_setup=0

if [ -f "${TARGET}/package.json" ]; then
  runner=$(node_runner)
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  has_command "${runner}" || fail "${runner} is required by the detected Node.js project"
  note "installing Node.js dependencies with ${runner}"
  case "${runner}" in
  pnpm) run_project_command pnpm install --frozen-lockfile ;;
  yarn)
    if [ -f "${TARGET}/.yarnrc.yml" ]; then
      run_project_command yarn install --immutable
    else
      run_project_command yarn install --frozen-lockfile
    fi
    ;;
  npm)
    if [ -f "${TARGET}/package-lock.json" ]; then
      run_project_command npm ci
    else
      run_project_command npm install
    fi
    ;;
  *) fail "unsupported package runner: ${runner}" ;;
  esac
  did_setup=1
fi

if [ -f "${TARGET}/pyproject.toml" ] || [ -f "${TARGET}/requirements.txt" ]; then
  # Status selector; a non-zero result is expected and handled.
  # shellcheck disable=SC2310
  has_command python3 || fail "python3 is required by the detected Python project"
  if [ ! -x "${TARGET}/.venv/bin/python" ]; then
    note 'creating .venv'
    run_project_command python3 -m venv .venv
  fi
  py="${TARGET}/.venv/bin/python"
  note 'installing Python dependencies'
  run_project_command "${py}" -m pip install --upgrade pip
  if [ -f "${TARGET}/requirements.txt" ]; then
    run_project_command "${py}" -m pip install -r "${TARGET}/requirements.txt"
  else
    run_project_command "${py}" -m pip install -e "${TARGET}"
  fi
  did_setup=1
fi

[ "${did_setup}" -eq 1 ] || fail 'no supported package manifest found'
note 'complete'
