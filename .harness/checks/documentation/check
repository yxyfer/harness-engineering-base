#!/usr/bin/env python3
from pathlib import Path
import re
import sys
from urllib.parse import unquote

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "bin"))
from source_paths import load_config, walk_files
from profiles import resolve
from readiness import context_status
from project_work import check_indexes
from project_records import WorkError

target = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
try:
    check_indexes(target)
except (WorkError, OSError) as error:
    print(f"documentation: project structure: {error}", file=sys.stderr)
    raise SystemExit(1)
config = load_config(target)
selection = resolve(target, config)
markdown_files = [
    path
    for path in walk_files(target, config["analysis"]["exclude"])
    if path.suffix == ".md"
]

link_pattern = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")
errors = []
for path in markdown_files:
    text = path.read_text(encoding="utf-8")
    for raw_target in link_pattern.findall(text):
        raw_target = raw_target.strip()
        link = (
            raw_target[1:].split(">", 1)[0]
            if raw_target.startswith("<")
            else raw_target.split()[0]
        )
        if link.startswith(("http://", "https://", "mailto:", "#")):
            continue
        local = unquote(link.split("#", 1)[0])
        if not local:
            continue
        resolved = (path.parent / local).resolve()
        if not resolved.exists():
            errors.append(f"{path.relative_to(target)} -> {link}")

if errors:
    print("documentation: broken local links:", file=sys.stderr)
    for error in errors:
        print(f"  {error}", file=sys.stderr)
    raise SystemExit(1)

if config["schema_version"] == 2 or (target / "AGENTS.md").exists():
    context = context_status(target, config, selection)
    for row in context:
        if row["state"] != "present":
            print(f"documentation: context {row['path']}: {row['state']}")
    if any(row["blocking"] for row in context):
        print("documentation: required context is not ready", file=sys.stderr)
        raise SystemExit(1)

print(f"documentation: pass ({len(markdown_files)} Markdown files)")
