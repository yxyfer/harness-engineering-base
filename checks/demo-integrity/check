#!/usr/bin/env python3
from pathlib import Path
import re
import sys

target = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
ignored_dirs = {".git", "node_modules", ".venv", "dist", "build"}
text_extensions = {".md", ".txt", ".js", ".jsx", ".ts", ".tsx", ".py", ".html"}
claim = re.compile(r"\b(live integration|production data|connected to production|real[- ]time data)\b", re.I)
matches = []

for path in target.rglob("*"):
    if not path.is_file() or path.suffix.lower() not in text_extensions:
        continue
    if any(part in ignored_dirs for part in path.parts):
        continue
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        continue
    if claim.search(text):
        matches.append(path.relative_to(target))

if not matches:
    print("demo-integrity: pass (no strong live/production claims detected)")
    raise SystemExit(0)

data_file = target / "docs" / "DATA.md"
if not data_file.is_file():
    print("demo-integrity: live/production claim found but docs/DATA.md is missing", file=sys.stderr)
    raise SystemExit(1)

data_text = data_file.read_text(encoding="utf-8").lower()
if "real" not in data_text or "simulated" not in data_text:
    print("demo-integrity: DATA.md must distinguish real and simulated behaviour", file=sys.stderr)
    raise SystemExit(1)

print(f"demo-integrity: pass (classification context present for {len(matches)} claim file(s))")
