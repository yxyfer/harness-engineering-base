#!/usr/bin/env python3
from pathlib import Path
import sys

target = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
data_file = target / "docs" / "DATA.md"
if not (target / "AGENTS.md").is_file():
    print("provenance: skip (AGENTS.md not present)")
    raise SystemExit(0)
if not data_file.is_file():
    print("provenance: docs/DATA.md is missing", file=sys.stderr)
    raise SystemExit(1)

text = data_file.read_text(encoding="utf-8").lower()
required = ["## provenance", "source", "limitations", "synthetic", "simulated"]
missing = [term for term in required if term not in text]
if missing:
    print(f"provenance: DATA.md is missing: {', '.join(missing)}", file=sys.stderr)
    raise SystemExit(1)

print("provenance: pass")
