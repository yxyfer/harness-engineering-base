{
  "name": "harness-nextjs-work-items",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.10.0",
    "npm": "11.6.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "db:init": "node scripts/database.ts init",
    "db:migrate": "node scripts/database.ts migrate",
    "db:seed": "node scripts/database.ts seed",
    "db:reset": "node scripts/database.ts reset --confirm-disposable",
    "smoke": "node scripts/journeys.ts --grep @smoke",
    "test:journeys": "node scripts/journeys.ts",
    "test:ui": "node scripts/journeys.ts --grep @ui",
    "test:visual": "node scripts/journeys.ts --grep @visual-approved",
    "test:ui-regressions": "node scripts/ui-regressions.ts",
    "ui:candidates": "node scripts/ui-candidates.ts",
    "test:regressions": "node scripts/journey-regressions.ts",
    "test:cleanup": "node scripts/journey-lifecycle.ts",
    "test:evidence": "vitest run --reporter=default --reporter=junit"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iron-session": "9.0.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
