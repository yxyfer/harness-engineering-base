#!/usr/bin/env python3
from pathlib import Path
import re
import sys
from urllib.parse import unquote

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "bin"))
from source_paths import load_config, walk_files

target = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
markdown_files = [
    path
    for path in walk_files(target, load_config(target)["analysis"]["exclude"])
    if path.suffix == ".md"
]

link_pattern = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")
errors = []
for path in markdown_files:
    text = path.read_text(encoding="utf-8")
    for raw_target in link_pattern.findall(text):
        raw_target = raw_target.strip()
        link = (raw_target[1:].split(">", 1)[0] if raw_target.startswith("<")
                else raw_target.split()[0])
        if link.startswith(("http://", "https://", "mailto:", "#")):
            continue
        local = unquote(link.split("#", 1)[0])
        if not local:
            continue
        resolved = (path.parent / local).resolve()
        if not resolved.exists():
            errors.append(f"{path.relative_to(target)} -> {link}")

if errors:
    print("documentation: broken local links:", file=sys.stderr)
    for error in errors:
        print(f"  {error}", file=sys.stderr)
    raise SystemExit(1)

unfinished = []
for path in markdown_files:
    if path != target / "AGENTS.md" and path.parent != target / "docs":
        continue
    if "Status: needs-project-input" in path.read_text(encoding="utf-8"):
        unfinished.append(str(path.relative_to(target)))
if unfinished:
    print(f"documentation: warning: project input needed in {', '.join(unfinished)}")

print(f"documentation: pass ({len(markdown_files)} Markdown files)")
