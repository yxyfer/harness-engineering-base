#!/bin/sh

HARNESS_COMMAND_NAME='harness format'
export HARNESS_COMMAND_NAME
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
. "$(dirname "$0")/common.sh"
resolve_target "${1:-.}"
python3 "${KIT_ROOT}/bin/profiles.py" summary "${TARGET}" "${CONFIG_PATH}"

# Status selector; absence selects native defaults.
# shellcheck disable=SC2310
if override=$(command_override format); then
  source_name=$(command_override_source format)
  run_override "${source_name}" "${override}"
elif has_npm_script format; then
  run_node_script format
else
  run_project_command python3 "${KIT_ROOT}/bin/static.py" format "${TARGET}" "${CONFIG_PATH}"
fi
note 'complete; formatting does not establish lint/type/test correctness'
