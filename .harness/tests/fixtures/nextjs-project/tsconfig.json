{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "target": "ES2022",
    "types": ["node", "react"]
  },
  "include": ["app/**/*", "scripts/**/*", "tests/**/*"]
}
